# --- Connect to a real Informer instance (optional) ---------------------------
# When INFORMER_URL is set, @entrinsik/vite-plugin-informer proxies /api, runs
# server/ handlers against your dev workspace and agents against Informer AI.
# Leave it unset to run the fully offline local mirror (PGlite + local agents).
#INFORMER_URL=https://your-instance.entrinsik.com
#INFORMER_API_KEY=your-api-key

# --- Optional: give the offline mirror a real LLM -----------------------------
# Used by the local mirror of Informer's /api/models/:id/_chat, _object and
# _completion endpoints. Without it the mirror runs the deterministic
# rule-based fallback so demos never depend on Wi-Fi.
#ANTHROPIC_API_KEY=sk-ant-...
