{
  "name": "arcrx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ArcRx - webcam range-of-motion rehab coach with governed clinical analytics on Informer Apps",
  "informer": {
    "name": "ArcRx Rehab Coach",
    "description": "Browser-native computer-vision physical therapy coach with longitudinal ROM analytics and AI triage agents",
    "icon": "accessibility_new"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --no-warnings test/smoke.mjs",
    "deploy": "npm run build && informer-deploy",
    "workspace:init": "informer-workspace init",
    "workspace:migrate": "informer-workspace migrate",
    "workspace:reset": "informer-workspace reset",
    "models:fetch": "node dev/fetch-models.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@mediapipe/tasks-vision": "^1.2.2",
    "js-yaml": "^5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@entrinsik/vite-plugin-informer": "^2.14.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
